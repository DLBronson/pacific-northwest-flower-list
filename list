#----------------------------------------------------------------------------------
# Define stacks to capture mill5$ for the next operation during tooltable preread
#    and flag whether there is rotary chenge between operations.
#----------------------------------------------------------------------------------
stack1_size   : 0  # Holds the size of the stack
stack1_result : 0  # Holds the result of the stack operation (push, pop)
stacked_op_id : -1 # op_id$ as read during the tooltable preread. This is the first element of a stack record.
next_mill5    : 0  # Stores the next mill5$ value.  This is the second element of a stack record.
fstack 1 2 0

plane_change  : 0  # Used to tell if plane changes between ops / toolchanges.

stack2_size   : 0
stack2_result : 0
tplane_has_changed  : 0  # Used to check next operations tlplnno$ value.  Only available in ptoolend$
fstack 2 2 0

# --------------------------------------------------------------------------
# Format statements - n=nonmodal, l=leading, t=trailing, i=inc, d=delta
# --------------------------------------------------------------------------
#Default english/metric position format statements
fs2 1   0.9 0.8      #Decimal, absolute, 7 place, default for initialize (:)
fs2 2   0.4 0.3      #Decimal, absolute, 4/3 place (linear positioning)
fs2 3   0.4 0.3d     #Decimal, delta, 4/3 place

#Common format statements
fs2 4   1 0 1 0      #Integer, not leading
fs2 5   2 0 2 0l     #Integer, force two leading
fs2 6   3 0 3 0l     #Integer, force three leading
fs2 7   4 0 4 0l     #Integer, force four leading
fs2 9   0.1 0.1      #Decimal, absolute, 1 place
fs2 10  0.2 0.2      #Decimal, absolute, 2 place
fs2 11  0 3 0 3t     #No decimal, absolute, 3 place
fs2 12  0.4 0.4      #Decimal, absolute, 4 place
fs2 13  0.5 0.5      #Decimal, absolute, 5 place
fs2 14  0.3 0.3d     #Decimal, delta, 3 place
fs2 15  0.2 0.1      #Decimal, absolute, 2/1 place
fs2 16  1 0 1 0n     #Integer, forced output
fs2 17  0.2 0.3      #Decimal, absolute, 2/3 place (tapping feedrate)

fs2 20  0.3 0.3      #Decimal, absolute, 3 place (rotary positioning)
fs2 21  0.3 0.3d     #Decimal, delta, 3 place

# These formats used for 'Date' & 'Time'
fs2 22  2.2 2.2lt    #Decimal, force two leading & two trailing (time2)
fs2 23  2 0 2 0t     #Integer, force trailing                   (hour)
fs2 24  0 2 0 2lt    #Integer, force leading & trailing         (min)

#The variables, i, j, k and xout, yout, zout use 'newfs' (format statement
# reassignment) with format statements 2 and 3.
#The variables, p_out, s_out use 'newfs' with format statements 20 and 21.
fs2 25  0.9 0.9      #Decimal, absolute, 7 place, default for initialize (:)
fs2 26  0.3 0.2      #Decimal, absolute, 3/2 place

