# --------------------------------------------------------------------------
# Tool Comment / Manual Entry Section
# --------------------------------------------------------------------------
ptoolcomment    #Comment for tool
          tnote = t$, toffnote = tloffno$, tlngnote = tlngno$
          if tool_info = 1 | tool_info = 3,
            [
            pstrtool #Convert strtool$ to uppercase if string is not empty
            scomm_fx_arg = strtool$
#//            scomm_fx_arg = strtool$ + sdelimiter + drs_str(2, tnote) + sdelimiter +
#//              drs_str(2, toffnote) + sdelimiter + drs_str(2, tlngnote) + sdelimiter + drs_str(2, tldia$)
            pcomment_out #Check comment length and output to NC file
            ]

ptooltable      #Tooltable output
          pstrtool #check strtool and force uppercase
          #Check comp_type, set sccomp_comm
          if comp_type > 0 & comp_type < 4, sccomp_comm = sdelimiter + slout(comp_type, scomp)
          else, sccomp_comm = sblank
          #Check xy_stock and z_stock, set sstock_left_comm
          if xy_stock <> 0 | z_stock <> 0, sstock_left_comm = sdelimiter + drs_str(2, xy_stock) + sdelimiter + drs_str(2, z_stock)
          else, sstock_left_comm = sblank
          #Build string for comment length check
          scomm_fx_arg = drs_str(2, t$) + sdelimiter + strtool$
#//          scomm_fx_arg = drs_str(2, t$) + sdelimiter + strtool$ + sdelimiter + drs_str(2, tlngno$) + sdelimiter +
#//            drs_str(2, tloffno$) + sdelimiter + drs_str(2, tldia$) + sccomp_comm + sstock_left_comm
          pcomment_out #Check comment length and output to NC file
          xy_stock = 0  #Reset stock to leave values
          z_stock = 0   #Reset stock to leave values

pstrtool        #Force uppercase comment for tool
           if strtool$ <> sblank, strtool$ = ucase(strtool$)

pcomment$       #Comment from manual entry (must call pcomment2)
      pcomment2 #Required if doing boolean 'if' logic testing!

pcomment2       #Output Comment from manual entry
      scomm$ = ucase (scomm$)
      if gcode$ = 1005 | gcode$ = 1006 | gcode$ = 1007 | gcode$ = 1026,
      [
      if gcode$ = 1005,
      [
      if scomm$ <> sblank, sbuffer3 = sopen_prn + scomm$ + sclose_prn #Manual entry - as comment
      else, sbuffer3 = " "
      ]
      if gcode$ = 1006, sbuffer3 = scomm$ #Manual entry - as code
      if gcode$ = 1007, sbuffer3 = sopen_prn + scomm$ + sclose_prn #Manual entry - as comment with move NO e$
      if gcode$ = 1026, sbuffer3 = scomm$ #Manual entry - as code with move NO e$
      sbuffer3 = wbuf(3, wc3)
      ]

      if gcode$ = 1008, #Record Operation Comments
      [
      if scomm$ <> sblank, sbuffer4 = sopen_prn + scomm$ + sclose_prn #Operation comment
      else, sbuffer4 = " "
      sbuffer4 = wbuf(4, wc4)
      ]

      if gcode$ = 1051, sopen_prn, scomm$, sclose_prn, e$  #Machine name
      if gcode$ = 1052, sopen_prn, scomm$, sclose_prn, e$  #Group comment
      if gcode$ = 1053, sopen_prn, scomm$, sclose_prn, e$  #Group name

      if gcode$ = 1054 & scomm$ <> sblank,
      [
      if scomm$ <> sblank, sbuffer2 = sopen_prn + scomm$ + sclose_prn #File Descriptor
      else, sbuffer2 = " "
      sbuffer2 = wbuf(2, wc2)
      ]

pfile_descriptor    #Write File Descriptor
      size2 = rbuf(2,0)
      if size2 > zero,
      [
      rc2 = one
      while rc2 <= size2,
      [
      sbuffer2 = rbuf(2, rc2)
      *sbuffer2, e$
      ]
      rc2 = one, wc2 = one, result = fclose(2)
      ]

pmanual_entry    #Write Manual Entry
      size3 = rbuf(3,0)
      if size3 > zero,
      [
      rc3 = one
      while rc3 <= size3,
      [
      sbuffer3 = rbuf(3, rc3)
      *sbuffer3, e$
      ]
      rc3 = one, wc3 = one, result = fclose(3)
      ]

poperation_comment       #Write Operation Comment
      size4 = rbuf(4,0)
      if size4 > zero,
      [
      rc4 = one
      while rc4 <= size4,
      [
      sbuffer4 = rbuf(4, rc4)
      *sbuffer4, e$
      ]
      rc4 = one, wc3 = one, result = fclose(4)
      ]

pcomment_probe$ #Renishaw probe 'comment' output postblock
          scomm$, e$

pcomment_out #Check comment length, truncate/shorten if necessary
          comm_len = strlen(sopen_prn + sclose_prn) #Get length of comment begin and end strings
          scomm_out = comment_fx(maxnccomment$ - comm_len, scomm_fx_arg, comment_mode)
          sopen_prn, no_spc$, scomm_out, no_spc$, sclose_prn, e$ #Output truncated comment
          scomm_out = sblank #Reset scomm_out

# --------------------------------------------------------------------------
# Start of File and Toolchange Setup
# --------------------------------------------------------------------------
pconvert_rpd # Manage convert rapid to feed at toolchanges/retract
          if convert_rapid,
          [
          if gcode$ = one, feed = rapid_feed, ipr_type = zero
          ]

p_goto_strt_tl  #Make the tool start up at toolchange
          pset_machine_mode
          if force_toolchange, pspindle
          if not(sof_flag),
          [
          if force_toolchange, pbld, n$, sm00, e$
          else, pbld, n$, sm01, e$
          *e$
          ]
          force_toolchange = no$
          pfd_shft_inc
          psign_ang_out
          if operations_list, pbld, p_write_op_seq_number(op_id$), e$
          op_counter = op_counter + one
          op_number = opinfo(15240, 0)
          if abs(seq_marker) = one, seq_mark = t$
          if abs(seq_marker) = two, seq_mark = op_counter
          if abs(seq_marker) = three, seq_mark = op_number
          if seq_marker, *seq_mark, [if seq_marker > zero, sopen_prn, no_spc$, *op_number, no_spc$, sclose_prn], e$
          poperation_comment
          pbld, n$, ptoolcomment, e$
          pbld, n$, *sgcode, *sgplane, *sg40, "G49", "G80", *sg90, *sgfeed, "G53 Z0", e$
          pbld, n$, *t$, "M06", e$
          if stagetool = one, pbld, n$, next_tool$, e$
          probing_after_toolchange  #//Mastercam
          if and(prb_operation, Prb_Active), pbld, n$, *spindle, pgear, e$  #//Mastercam Probe
          else, pbld, n$, *speed, *spindle, pgear, e$
          if coolant$ > two, pbld, n$, pscool, e$  #Coolant Before
          pcan
          if not(auto_clamp), punclamp
          pbld, n$, pscool, e$  #Coolant
          if supports_g68 & tool_op$ = 28, n_tpln_mch = five #//Force drill mapping
          if supports_g68 & n_tpln_mch > m_one, #Toolplane mapping mode
            [
            pbld, n$, *sgcode, *sgabsinc, pwcs, pfrout, e$
            pg68_map
            pg68
            pclamp
            tool_length = one
            pcan1, pbld, n$, *xout, *yout, strcantext, pcan1_cool, e$
            if not(drill_actv), phsm_on
            pbld, n$, *sgtool_length, *tlngno$, *zout, e$, tcp_actv = no$
            ]
          else,
          [
          #5 axis and regular mode ( n_tpln_mch = -2)
          if cut_ra_head & use_g45, #Swap xout and yout based on offset axis
            [
            tloffno2 = tlngno$ + g45_of_add
            pcan1, pbld, n$, *sgcode, pwcs, *sgabsinc, *yout, pfrout, *speed, *spindle, pgear, strcantext, pcan1_cool, e$
            pbld, n$, "G45", *tloffno2, *xout, e$
            ]
          else,
            [
            result = force(p_out, s_out)
            pbld, n$, *sgcode, *sgabsinc, pwcs, pfrout, e$
            if tool_length = two,
            [
            pmapped_position
            mmtx1 = matt(m1$)  #Transpose current tool plane matrix
            result_x = vmap(tox$, mmtx1)
            xabs = vadd(result_x, brk_xa)
            pbld, n$, *sgtool_length, *tlngno$, e$ tcp_actv = yes$ #//Output "G43.4"
            pbld, n$, *xout, *yout, *zout, e$
            ]
            else,
            [
            tool_length = yes$
            pcan1, pbld, n$, *xout, *yout, strcantext, pcan1_cool, e$
            if not(drill_actv), phsm_on
            pbld, n$, *sgtool_length, *tlngno$, *zout, e$, tcp_actv = no$ #//Output "G43"
            ]
            ]
           ]
          if auto_clamp & cuttype, pfunclamp
          else, pbld, n$, pclamp, e$
          probing_after_coordinates  #//Mastercam
          if top_map, !n_tpln_mch
          psign_ang_res
          pcom_movea
          op_change = no$
          p_dlt_ang = zero, s_dlt_ang = zero
          toolchng = no$, prv_feed = m_one

p_goto_strt_ntl(skip_process, pass_thru) #Make the tool start up at null toolchange
          pass_thru = no$
          skip_process = no$
          linking = no$
          if tool_op$  =154 & link_op$ = 154 & nextop$ = 11, linking = yes$  #//Multiaxis Linking
          if tool_op$ = 28 & link_op$ = 155 & nextop$ = 11, linking = yes$  #//Drill5x Saftey Zone
          if tool_op$ = 28, pass_thru = yes$  #//Force thru
          if mill5$ = one & op_change = one, pass_thru = yes$
          if tool_op$ = 28 & link_op$ = 155 & op_change = three, skip_process = yes$
          if workofs$ <> prev_workofs
            | tplane_has_changed
            | (top_map & (prv_n_tpln_mch <> n_tpln_mch))
            | (fmtrnd(prv_p_out) <> fmtrnd(p_out) | fmtrnd(prv_s_out) <> fmtrnd(s_out))
            | pass_thru
            & not(skip_process),
            [
            result = no$  #//Retract No
            if not(safe_z_ret), result = no$  #//Retract No
            if tplane_has_changed, result = yes$  #//Retract Yes
            if cuttype <> prev_cuttype, result = yes$ #//Retract Yes
            if unwind_actv, result = yes$  #//Retract Yes
            if mi1$ & not(unwind_actv), result = no$  #//Check for unwinding axis
            if mill5$ = one & prv_mill5$ = one & op_change = one, result = yes$
            if result, psafe_retract  #//Retract Yes
            if g05_actv & (opinfo(15237, -1) <> opinfo(15237, 0)), phsm_cancel  #//082823
            if tool_length, tool_length = no$, pbld, n$, *sgtool_length, e$, tcp_actv = no$
            if g68_actv, pg69, e$
            if opinfo(15237, -1) <> opinfo(15237, 0), poperation_comment
            pset_machine_mode
            pfd_shft_inc
            sav_absinc = absinc$
            absinc$ = zero
            p_absinc_chng
            psign_ang_out
            probing_after_toolchange  #//Mastercam
            if not(auto_clamp), punclamp
            gcode$ = zero
            if force_wcs, prev_workofs = m_one, !prev_workofs

            #//Setup 5-axis linking output
            result = no$
            if link_op$ = 154 | link_op$ = 155, result = yes$
            if result,
            [
            if supports_tcp, tool_length = two
            brk_mv_head = no$
            n_tpln_mch = m_one
            ]
            if supports_g68 & tool_op$ = 28, n_tpln_mch = five #//Force drill mapping
            if supports_g68 & n_tpln_mch > m_one, #Toolplane mapping mode
              [
                link_actv = no$
                pbld, n$, *sgcode, *sgabsinc, pwcs, pfrout, e$
                pclamp
                pg68_map
                pg68
                pcan1, pbld, n$, sgcode, *xout, *yout, strcantext, pcan1_cool, e$
                if not(drill_actv), phsm_on
                pbld, n$, *sgtool_length, *tlngno$, *zout, e$, tcp_actv = no$
              ]
          else,
            [
            result = force(p_out, s_out)
            pbld, n$, *sgcode, *sgabsinc, pwcs, pfrout, e$
            if link_actv & supports_tcp, tool_length = two
            if tool_length = two,
            [
            pmapped_position
            mmtx1 = matt(m1$)  #Transpose current tool plane matrix
            result_x = vmap(tox$, mmtx1)
            xabs = vadd(result_x, brk_xa)
            pbld, n$, *sgtool_length, *tlngno$, e$ tcp_actv = yes$ #//Output "G43.4"
            pbld, n$, *xout, *yout, *zout, e$
            mtype = two
            ]
            else,
            [
            pcan1, pbld, n$, *xout, *yout, strcantext, pcan1_cool, e$
            if not(drill_actv), phsm_on
            pbld, n$, *sgtool_length, *tlngno$, *zout, e$, tcp_actv = no$ #//Output "G43"
            mtype = zero
            ]
            ]
            if auto_clamp & cuttype, pfunclamp
            else, pbld, n$, pclamp, e$
            psign_ang_res
            pe_inc_calc
            absinc$ = sav_absinc
            ps_inc_calc
            pcom_movea
            prv_feed = m_one
            ]
          else,
            [
            probing_after_toolchange  #//Mastercam
            p_goto_pos
            ]
          if top_map, !n_tpln_mch
          op_change = no$
          safe_z_ret = prev_safe_z_ret
          p_dlt_ang = zero, s_dlt_ang = zero

psafe_retract      #Safe clearance move
         if op_change & start_op_ret,  #//Start Op
         [
         if g68_actv, pg69  #//Cancel G68.2
         if tcp_actv, tool_length = zero, pbld, n$, sgtool_length, e$, tcp_actv = no$  #//Cancel TCP
         if start_op_ret < three, pbld, n$, sg00, sg91, "G28", "Z0.", e$
         if start_op_ret = two, pbld, n$, sg00, sg91, "G28", "X0.", "Y0.", e$
         ]

         if not(op_change) & mid_op_ret,  #//Mid Op
         [
         if g68_actv, pg69  #//Cancel G68.2
         if tcp_actv, tool_length = zero, pbld, n$, sgtool_length, e$, tcp_actv = no$  #//Cancel TCP
         if mid_op_ret < three, pbld, n$, sg00, sg91, "G28", "Z0.", e$
         if mid_op_ret = two, pbld, n$, sg00, sg91, "G28", "X0.", "Y0.", e$
         ]

ptime           #Convert 24-hour time format into 12-hour AM/PM format
          if time$ >= 13, time2 = (time$ - 12)
          else, time2 = time$
          hour = int(time2), min = frac(time2)
          *hour, ":", *min,
          if time$ > 12, " PM"
          else, " AM"

pheader$         #Call before start of file
          if prompt_zshift, q4  #//Prompt for Z part shifting...
          if omit_seq, omitseq$ = yes$
          rd_tlpathgrp$
          "%", e$
          spaces$ = zero
          if not(progno$), progno$ = 1000
          *progno$, 32, sopen_prn, sprogname$, sclose_prn, e$
           comment$
          pmanual_entry
          pfile_descriptor
          sopen_prn, "POSTED - ", *month_2, "-", *day_2, "-", *year_2, 32, ptime, sclose_prn, e$
          sopen_prn, "MACHINE - ", snamepst$, sclose_prn, e$
          if custom_header, pheader_comments
          spathnc$ = ucase(spathnc$)
          smcname$ = ucase(smcname$)
          stck_matl$ = ucase(stck_matl$)
          snamenc$ = ucase(snamenc$)
          #sopen_prn, "MCX FILE - ", *smcpath$, *smcname$, *smcext$, sclose_prn, e$
